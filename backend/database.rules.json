{
  "rules": {
    ".read": false,
    ".write": false,
    "shares": {
      "$token": {
        ".read": "$token.length >= 24",
        ".write": "$token.length >= 24",
        ".validate": "newData.hasChildren(['ownerName', 'status', 'startedAt', 'expiresAt', 'updatedAt'])",
        "ownerName": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "status": { ".validate": "newData.isString() && (newData.val() == 'active' || newData.val() == 'sos')" },
        "startedAt": { ".validate": "newData.isNumber()" },
        "expiresAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "sosAt": { ".validate": "newData.isNumber()" },
        "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "lon": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "accuracy": { ".validate": "newData.isNumber()" },
        "trailActive": { ".validate": "newData.isBoolean()" },
        "distanceMeters": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
